{
  "name": "qa_capstone",
  "version": "1.0.0",
  "description": "Enterprise Playwright TypeScript QA Capstone — automationexercise.com",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:all": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:auth": "playwright test tests/auth/",
    "test:products": "playwright test tests/products/",
    "test:cart": "playwright test tests/cart/",
    "test:checkout": "playwright test tests/checkout/",
    "test:visual": "playwright test tests/visual/",
    "test:a11y": "playwright test tests/accessibility/",
    "test:update-snapshots": "playwright test --update-snapshots",
    "report": "playwright show-report reports/html",
    "trace": "playwright show-trace",
    "codegen": "playwright codegen https://automationexercise.com"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "qa",
    "testing"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@faker-js/faker": "^10.6.0",
    "@playwright/mcp": "^0.0.83",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
